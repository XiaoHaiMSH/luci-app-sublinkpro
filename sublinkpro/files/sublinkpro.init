#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

NAME=sublinkpro
PROG=/usr/bin/sublinkPro

EXTRA_COMMANDS="reset_password"
EXTRA_HELP="	reset_password <new password> [username]	Reset login password (default user: admin)"

get() { uci -q get "$NAME.main.$1"; }

start_service() {
	[ "$(get enabled)" = "1" ] || return 0

	local port db_path log_path
	port="$(get port)";           [ -n "$port" ] || port=8000
	db_path="$(get db_path)";     [ -n "$db_path" ] || db_path=/etc/sublinkpro
	log_path="$(get log_path)";   [ -n "$log_path" ] || log_path=/var/log/sublinkpro

	mkdir -p "$db_path" "$log_path"
	chown -R sublinkpro:sublinkpro "$db_path" "$log_path" 2>/dev/null

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param user sublinkpro

	procd_set_param env \
		GIN_MODE=release \
		SUBLINK_PORT="$port" \
		SUBLINK_DB_PATH="$db_path" \
		SUBLINK_LOG_PATH="$log_path"

	local v
	v="$(get log_level)";          [ -n "$v" ] && procd_append_param env SUBLINK_LOG_LEVEL="$v"
	v="$(get expire_days)";        [ -n "$v" ] && procd_append_param env SUBLINK_EXPIRE_DAYS="$v"
	v="$(get web_base_path)";      [ -n "$v" ] && procd_append_param env SUBLINK_WEB_BASE_PATH="$v"
	v="$(get captcha_mode)";       [ -n "$v" ] && procd_append_param env SUBLINK_CAPTCHA_MODE="$v"
	v="$(get login_fail_count)";   [ -n "$v" ] && procd_append_param env SUBLINK_LOGIN_FAIL_COUNT="$v"
	v="$(get login_fail_window)";  [ -n "$v" ] && procd_append_param env SUBLINK_LOGIN_FAIL_WINDOW="$v"
	v="$(get login_ban_duration)"; [ -n "$v" ] && procd_append_param env SUBLINK_LOGIN_BAN_DURATION="$v"
	v="$(get admin_password)";     [ -n "$v" ] && procd_append_param env SUBLINK_ADMIN_PASSWORD="$v"
	v="$(get dsn)";                [ -n "$v" ] && procd_append_param env SUBLINK_DSN="$v"

	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/sublinkpro
	procd_close_instance

	if [ "$(get open_firewall)" = "1" ]; then
		uci -q delete firewall.sublinkpro
		uci -q set firewall.sublinkpro=rule
		uci -q set firewall.sublinkpro.name='Allow-SublinkPro'
		uci -q set firewall.sublinkpro.src='lan'
		uci -q set firewall.sublinkpro.proto='tcp'
		uci -q set firewall.sublinkpro.dest_port="$port"
		uci -q set firewall.sublinkpro.target='ACCEPT'
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
}

stop_service() {
	if uci -q get firewall.sublinkpro >/dev/null; then
		uci -q delete firewall.sublinkpro
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	fi
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}

reset_password() {
	[ -n "$1" ] || { echo "usage: /etc/init.d/sublinkpro reset_password <new password> [username]"; return 1; }
	local db_path user="${2:-admin}"
	db_path="$(get db_path)"; [ -n "$db_path" ] || db_path=/etc/sublinkpro
	/etc/init.d/sublinkpro stop
	"$PROG" setting -username "$user" -password "$1" -db "$db_path"
	chown -R sublinkpro:sublinkpro "$db_path" 2>/dev/null
	echo "已重置用户 $user 的密码，重新启动服务: /etc/init.d/sublinkpro start"
}
